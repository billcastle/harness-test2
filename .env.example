# Copy to .env and fill in. .env is git-ignored; never commit it.

# The subdomain that points at this server (DNS A/AAAA record first, so Caddy can get a certificate)
DOMAIN=expenses.example.com

# Database password. Use hex so it is safe inside a URL:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Backups (see deploy/README.md). Dumps are encrypted with rclone "crypt" before they leave this server.
# 1) the storage: any S3-compatible bucket (Backblaze B2, Cloudflare R2, AWS S3 ...). Keep the bucket private.
RCLONE_CONFIG_STORE_TYPE=s3
RCLONE_CONFIG_STORE_PROVIDER=Other
RCLONE_CONFIG_STORE_ENDPOINT=
RCLONE_CONFIG_STORE_ACCESS_KEY_ID=
RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=
# 2) the encryption layer on top of it. Passwords must be "obscured":  rclone obscure 'your passphrase'
#    Keep the passphrases somewhere other than this server (a password manager), or the backups cannot be read after a disaster.
RCLONE_CONFIG_SECURE_TYPE=crypt
RCLONE_CONFIG_SECURE_REMOTE=store:your-private-bucket/expenses
RCLONE_CONFIG_SECURE_PASSWORD=
RCLONE_CONFIG_SECURE_PASSWORD2=
# what the backup script writes to, and how long to keep dumps
BACKUP_REMOTE=secure:
BACKUP_KEEP_DAYS=30
BACKUP_INTERVAL_HOURS=24
# a dead-man's-switch URL (for example from healthchecks.io): pinged after every good backup, /fail on error,
# and silence alerts you. Leave empty to skip.
HEALTHCHECK_URL=
